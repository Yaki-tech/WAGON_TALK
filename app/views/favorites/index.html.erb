<div class="favorites">
  <header class="favorites__header">
    <%= link_to root_path, class: "back-link" do %>
      &larr; <%= t('favorites.back') %>
    <% end %>
  </header>

  <h1 class="favorites__title"><%= t('favorites.title') %></h1>

  <% if @favorites.any? %>
    <div class="favorites__list">
      <% @favorites.each do |favorite| %>
        <div class="favorites__item" id="<%= dom_id(favorite) %>">
          <div class="favorites__content">
            <p class="favorites__question"><%= favorite.question.translated_content %></p>
            <span class="favorites__deck"><%= favorite.question.deck.translated_title %></span>
          </div>
          <%= button_to favorite_path(favorite), method: :delete, class: "favorites__remove", title: t('favorites.remove') do %>
            &times;
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="favorites__empty">
      <p><%= t('favorites.empty') %></p>
      <p><%= t('favorites.empty_description') %></p>
      <%= link_to t('favorites.explore'), root_path, class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
